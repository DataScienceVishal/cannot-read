#!/usr/bin/env bash
# Installed to .git/hooks/pre-commit by scripts/install-hooks.sh.
#
# Checks the files that are staged, but reads them as they are on disk. A file
# staged with a banned line and then fixed without re-staging passes here and
# is committed with the line still in it, so re-stage before committing.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

python=python3
if [ -x .venv/bin/python ]; then
  python=.venv/bin/python
fi

# The venv's ruff, or none. Guarding the block with `command -v ruff` alone
# skips it in silence under uv, which puts ruff in .venv/bin and never on PATH.
# That is worse than a failure, because a skipped check and a passed check
# print the same nothing.
ruff=""
if [ -x .venv/bin/ruff ]; then
  ruff=.venv/bin/ruff
elif command -v ruff >/dev/null 2>&1; then
  ruff=$(command -v ruff)
fi

echo "pre-commit: fingerprint check"
if ! "$python" scripts/check_fingerprint.py --staged; then
  cat >&2 <<'MSG'

Commit blocked. Fix the hits above.

If one is genuinely wrong, add the ignore marker to that line, or add a new
entry to the allowed-contexts block in scripts/style-words.md when the false
positive will keep recurring. Do not disable the hook.
MSG
  exit 1
fi

# Ruff is cheap and catches the dead imports that pile up during a slice.
staged_py=$(git diff --cached --name-only --diff-filter=ACM -- '*.py')
if [ -n "$staged_py" ]; then
  if [ -z "$ruff" ]; then
    cat >&2 <<'MSG'

Commit blocked: no ruff. Run `uv sync --all-extras`.
MSG
    exit 1
  fi
  echo "pre-commit: ruff ($("$ruff" --version))"
  echo "$staged_py" | xargs "$ruff" check
fi

echo "pre-commit: ok"
